MASSIVE_API_KEY=
# For the Blurb run (uv run python -m app.blurbs) and ChatWithAI; chat is off without it
ANTHROPIC_API_KEY=
# Dev uses local Postgres.app (postgresql://postgres@localhost:5432/market), so leave
# DATABASE_URL out of this file. Production goes in backend/.env.production (gitignored):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# and is used only when asked for:  uv run --env-file .env.production fastapi dev app/main.py
